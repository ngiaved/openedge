{
  "variables": {
    "edge_compose_source": "http",
    "edge_compose_url": "",
    "edge_compose_bucket": "",
    "edge_compose_object": "",
    "edge_compose_project": "",
    "edge_compose_services": "",
    "edge_fetch_retries": "5",
    "edge_fetch_delay": "15",
    "edge_s3_region": "",
    "edge_compose_env_b64": "",
    "edge_cloud_credentials_b64": "",
    "edge_net_mode": "dhcp",
    "edge_net_address": "",
    "edge_net_netmask": "",
    "edge_net_gateway": "",
    "edge_net_dns": "",
    "edge_boot_script_url": "",
    "edge_login_url": ""
  },
  "builders": [
    {
      "type": "qemu",
      "name": "qemu",
      "accelerator": "tcg",
      "boot_command": [
        "<esc><wait>",
        "<esc><wait>",
        "<enter><wait>",
        "/install/vmlinuz<wait>",
        " auto<wait>",
        " console-setup/ask_detect=false<wait>",
        " console-setup/layoutcode=us<wait>",
        " console-setup/modelcode=pc105<wait>",
        " debconf/frontend=noninteractive<wait>",
        " debian-installer=en_US<wait>",
        " fb=false<wait>",
        " initrd=/install/initrd.gz<wait>",
        " kbd-chooser/method=us<wait>",
        " keyboard-configuration/layout=USA<wait>",
        " keyboard-configuration/variant=USA<wait>",
        " locale=en_US<wait>",
        " netcfg/get_domain=vm<wait>",
        " netcfg/get_hostname=vagrant<wait>",
        " grub-installer/bootdev=/dev/sda<wait>",
        " noapic<wait>",
        " preseed/url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/preseed.cfg<wait>",
        " -- <wait>",
        "<enter><wait>"
      ],
      "boot_wait": "10s",
      "disk_image": false,
      "disk_interface": "ide",
      "disk_size": 81920,
      "format": "qcow2",
      "headless": true,
      "http_directory": "http",
      "iso_checksum": "sha256:7d8e0055d663bffa27c1718685085626cb59346e7626ba3d3f476322271f573e",
      "iso_urls": [
        "iso/ubuntu-18.04.3-server-amd64.iso",
        "https://old-releases.ubuntu.com/releases/18.04.3/ubuntu-18.04.3-server-amd64.iso"
      ],
      "memory": 2048,
      "cpus": 2,
      "qemuargs": [
        [
          "-machine",
          "q35"
        ],
        [
          "-cpu",
          "max"
        ]
      ],
      "shutdown_command": "echo 'vagrant'|sudo -S shutdown -P now",
      "ssh_password": "vagrant",
      "ssh_port": 22,
      "ssh_timeout": "10000s",
      "ssh_username": "vagrant",
      "vm_name": "openedge",
      "output_directory": "builds/qemu"
    },
    {
      "type": "virtualbox-iso",
      "name": "virtualbox-iso",
      "boot_command": [
        "<esc><wait>",
        "<esc><wait>",
        "<enter><wait>",
        "/install/vmlinuz<wait>",
        " auto<wait>",
        " console-setup/ask_detect=false<wait>",
        " console-setup/layoutcode=us<wait>",
        " console-setup/modelcode=pc105<wait>",
        " debconf/frontend=noninteractive<wait>",
        " debian-installer=en_US<wait>",
        " fb=false<wait>",
        " initrd=/install/initrd.gz<wait>",
        " kbd-chooser/method=us<wait>",
        " keyboard-configuration/layout=USA<wait>",
        " keyboard-configuration/variant=USA<wait>",
        " locale=en_US<wait>",
        " netcfg/get_domain=vm<wait>",
        " netcfg/get_hostname=vagrant<wait>",
        " grub-installer/bootdev=/dev/sda<wait>",
        " noapic<wait>",
        " preseed/url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/preseed.cfg<wait>",
        " -- <wait>",
        "<enter><wait>"
      ],
      "boot_wait": "10s",
      "disk_size": 81920,
      "guest_additions_path": "VBoxGuestAdditions_{{.Version}}.iso",
      "guest_os_type": "Ubuntu_64",
      "headless": true,
      "http_directory": "http",
      "iso_checksum": "sha256:7d8e0055d663bffa27c1718685085626cb59346e7626ba3d3f476322271f573e",
      "iso_urls": [
        "iso/ubuntu-18.04.3-server-amd64.iso",
        "https://old-releases.ubuntu.com/releases/18.04.3/ubuntu-18.04.3-server-amd64.iso"
      ],
      "shutdown_command": "echo 'vagrant'|sudo -S shutdown -P now",
      "ssh_password": "vagrant",
      "ssh_port": 22,
      "ssh_timeout": "10000s",
      "ssh_username": "vagrant",
      "vboxmanage": [
        [
          "modifyvm",
          "{{.Name}}",
          "--memory",
          "1024"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--cpus",
          "1"
        ]
      ],
      "virtualbox_version_file": ".vbox_version",
      "vm_name": "openedge"
    }
  ],
  "post-processors": [
    [
      {
        "output": "builds/{{.Provider}}-ubuntu1804.box",
        "type": "vagrant",
        "only": [
          "virtualbox-iso"
        ]
      },
      {
        "execute_command": [
          "bash",
          "{{.Script}}"
        ],
        "script": "scripts/make-ova.sh",
        "type": "shell-local",
        "only": [
          "virtualbox-iso"
        ]
      }
    ]
  ],
  "provisioners": [
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/ansible.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/setup.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/docker.sh",
      "type": "shell"
    },
    {
      "destination": "/tmp/openedge-bootstrap.sh",
      "source": "scripts/openedge-bootstrap.sh",
      "type": "file"
    },
    {
      "destination": "/tmp/openedge-bootstrap.service",
      "source": "scripts/openedge-bootstrap.service",
      "type": "file"
    },
    {
      "destination": "/tmp/configure-network.sh",
      "source": "scripts/configure-network.sh",
      "type": "file"
    },
    {
      "destination": "/tmp/configure-network.service",
      "source": "scripts/configure-network.service",
      "type": "file"
    },
    {
      "environment_vars": [
        "EDGE_COMPOSE_SOURCE={{user `edge_compose_source`}}",
        "EDGE_COMPOSE_URL={{user `edge_compose_url`}}",
        "EDGE_COMPOSE_BUCKET={{user `edge_compose_bucket`}}",
        "EDGE_COMPOSE_OBJECT={{user `edge_compose_object`}}",
        "EDGE_COMPOSE_PROJECT={{user `edge_compose_project`}}",
        "EDGE_COMPOSE_SERVICES={{user `edge_compose_services`}}",
        "EDGE_FETCH_RETRIES={{user `edge_fetch_retries`}}",
        "EDGE_FETCH_DELAY={{user `edge_fetch_delay`}}",
        "EDGE_S3_REGION={{user `edge_s3_region`}}",
        "EDGE_COMPOSE_ENV_B64={{user `edge_compose_env_b64`}}",
        "EDGE_CLOUD_CREDENTIALS_B64={{user `edge_cloud_credentials_b64`}}",
        "EDGE_NET_MODE={{user `edge_net_mode`}}",
        "EDGE_NET_ADDRESS={{user `edge_net_address`}}",
        "EDGE_NET_NETMASK={{user `edge_net_netmask`}}",
        "EDGE_NET_GATEWAY={{user `edge_net_gateway`}}",
        "EDGE_NET_DNS={{user `edge_net_dns`}}",
        "EDGE_BOOT_SCRIPT_URL={{user `edge_boot_script_url`}}",
        "EDGE_LOGIN_URL={{user `edge_login_url`}}"
      ],
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/edge-bootstrap.sh",
      "type": "shell"
    },
    {
      "playbook_file": "ansible/main.yml",
      "type": "ansible-local"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/cleanup.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "only": [
        "virtualbox-iso"
      ],
      "script": "scripts/zero-disk.sh",
      "type": "shell"
    }
  ]
}

