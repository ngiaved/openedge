{
  "variables": {
    "edge_compose_source": "http",
    "edge_compose_url": "",
    "edge_compose_bucket": "",
    "edge_compose_object": "",
    "edge_compose_project": "",
    "edge_compose_services": "",
    "edge_fetch_retries": "5",
    "edge_fetch_delay": "15",
    "edge_s3_region": "",
    "edge_compose_env_b64": "",
    "edge_cloud_credentials_b64": "",
    "edge_net_mode": "dhcp",
    "edge_net_address": "",
    "edge_net_netmask": "",
    "edge_net_gateway": "",
    "edge_net_dns": "",
    "edge_boot_script_url": "",
    "edge_login_url": ""
  },
  "builders": [
    {
      "type": "qemu",
      "name": "qemu",
      "accelerator": "tcg",
      "boot_command": [
        "<wait>",
        "c<wait>",
        "linux /casper/vmlinuz quiet autoinstall cloud-config-url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/user-data ds=nocloud-net\\;s=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ ---<enter><wait>",
        "initrd /casper/initrd<enter><wait>",
        "boot<enter><wait>"
      ],
      "boot_wait": "10s",
      "disk_image": false,
      "disk_interface": "ide",
      "disk_size": 81920,
      "format": "qcow2",
      "headless": true,
      "http_directory": "http",
      "iso_checksum": "sha256:97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8",
      "iso_urls": [
        "iso/ubuntu-24.04.5-live-server-amd64.iso",
        "https://releases.ubuntu.com/24.04.5/ubuntu-24.04.5-live-server-amd64.iso"
      ],
      "memory": 2048,
      "cpus": 2,
      "qemuargs": [
        [
          "-machine",
          "q35"
        ],
        [
          "-cpu",
          "max"
        ]
      ],
      "shutdown_command": "echo 'vagrant'|sudo -S shutdown -P now",
      "ssh_password": "vagrant",
      "ssh_port": 22,
      "ssh_timeout": "10000s",
      "ssh_username": "vagrant",
      "vm_name": "openedge-2404",
      "output_directory": "builds/qemu-2404"
    },
    {
      "type": "virtualbox-iso",
      "name": "virtualbox-iso",
      "boot_command": [
        "<wait>",
        "c<wait>",
        "linux /casper/vmlinuz quiet autoinstall cloud-config-url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/user-data ds=nocloud-net\\;s=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ ---<enter><wait>",
        "initrd /casper/initrd<enter><wait>",
        "boot<enter><wait>"
      ],
      "boot_wait": "10s",
      "disk_size": 81920,
      "guest_additions_path": "VBoxGuestAdditions_{{.Version}}.iso",
      "guest_os_type": "Ubuntu_64",
      "headless": true,
      "http_directory": "http",
      "iso_checksum": "sha256:97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8",
      "iso_urls": [
        "iso/ubuntu-24.04.5-live-server-amd64.iso",
        "https://releases.ubuntu.com/24.04.5/ubuntu-24.04.5-live-server-amd64.iso"
      ],
      "shutdown_command": "echo 'vagrant'|sudo -S shutdown -P now",
      "ssh_password": "vagrant",
      "ssh_port": 22,
      "ssh_timeout": "10000s",
      "ssh_username": "vagrant",
      "vboxmanage": [
        [
          "modifyvm",
          "{{.Name}}",
          "--memory",
          "2048"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--cpus",
          "2"
        ]
      ],
      "virtualbox_version_file": ".vbox_version",
      "vm_name": "openedge-2404"
    }
  ],
  "post-processors": [
    [
      {
        "output": "builds/{{.Provider}}-ubuntu2404.box",
        "type": "vagrant",
        "only": [
          "virtualbox-iso"
        ]
      },
      {
        "execute_command": [
          "bash",
          "{{.Script}}",
          "virtualbox-ubuntu2404"
        ],
        "script": "scripts/make-ova.sh",
        "type": "shell-local",
        "only": [
          "virtualbox-iso"
        ]
      }
    ]
  ],
  "provisioners": [
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/ansible.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/setup.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/docker.sh",
      "type": "shell"
    },
    {
      "destination": "/tmp/openedge-bootstrap.sh",
      "source": "scripts/openedge-bootstrap.sh",
      "type": "file"
    },
    {
      "destination": "/tmp/openedge-bootstrap.service",
      "source": "scripts/openedge-bootstrap.service",
      "type": "file"
    },
    {
      "destination": "/tmp/configure-network.sh",
      "source": "scripts/configure-network.sh",
      "type": "file"
    },
    {
      "destination": "/tmp/configure-network.service",
      "source": "scripts/configure-network.service",
      "type": "file"
    },
    {
      "environment_vars": [
        "EDGE_COMPOSE_SOURCE={{user `edge_compose_source`}}",
        "EDGE_COMPOSE_URL={{user `edge_compose_url`}}",
        "EDGE_COMPOSE_BUCKET={{user `edge_compose_bucket`}}",
        "EDGE_COMPOSE_OBJECT={{user `edge_compose_object`}}",
        "EDGE_COMPOSE_PROJECT={{user `edge_compose_project`}}",
        "EDGE_COMPOSE_SERVICES={{user `edge_compose_services`}}",
        "EDGE_FETCH_RETRIES={{user `edge_fetch_retries`}}",
        "EDGE_FETCH_DELAY={{user `edge_fetch_delay`}}",
        "EDGE_S3_REGION={{user `edge_s3_region`}}",
        "EDGE_COMPOSE_ENV_B64={{user `edge_compose_env_b64`}}",
        "EDGE_CLOUD_CREDENTIALS_B64={{user `edge_cloud_credentials_b64`}}",
        "EDGE_NET_MODE={{user `edge_net_mode`}}",
        "EDGE_NET_ADDRESS={{user `edge_net_address`}}",
        "EDGE_NET_NETMASK={{user `edge_net_netmask`}}",
        "EDGE_NET_GATEWAY={{user `edge_net_gateway`}}",
        "EDGE_NET_DNS={{user `edge_net_dns`}}",
        "EDGE_BOOT_SCRIPT_URL={{user `edge_boot_script_url`}}",
        "EDGE_LOGIN_URL={{user `edge_login_url`}}"
      ],
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/edge-bootstrap.sh",
      "type": "shell"
    },
    {
      "playbook_file": "ansible/main.yml",
      "type": "ansible-local"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "script": "scripts/cleanup.sh",
      "type": "shell"
    },
    {
      "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
      "only": [
        "virtualbox-iso"
      ],
      "script": "scripts/zero-disk.sh",
      "type": "shell"
    }
  ]
}